{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["../../src/**/*.ts", "src.ts"],
  "exclude": ["../../src/**/*_test.ts"]
}
