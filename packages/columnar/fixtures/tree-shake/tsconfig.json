{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": [
    "../../src/**/*.ts",
    "../backend.ts",
    "../engine.ts",
    "../indexeddb_backend.ts",
    "../mod.ts",
    "../page_format.ts",
    "../schema.ts",
    "../stored_page.ts",
    "src.ts"
  ],
  "exclude": ["../../src/**/*_test.ts"]
}
