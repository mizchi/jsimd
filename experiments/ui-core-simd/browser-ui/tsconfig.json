    "../life_options.ts",
    "../life_shared.ts",
    "../patch_tape.ts",
    "../patch_tape_kernel.ts",
    "../patch_scenarios.ts",
    "../runtime_profile.ts",
    "../computed.ts",
    "../signal_graph.ts",
    "../signal_kernel.ts",
