{
  "name": "@mizchi/jsimd",
  "version": "0.1.0",
  "description": "Prebuilt WebAssembly SIMD kernels and Wasm-resident data structures for JavaScript",
  "type": "module",
  "exports": {
    ".": "./src/bytes/mod.ts",
    "./adaptive-simd-page-i32": "./src/adaptive-simd-page-i32/mod.ts",
    "./bitset": "./src/bitset/mod.ts",
    "./binary-vector-index": "./src/binary-vector-index/mod.ts",
    "./bit-sliced-column": "./src/bit-sliced-column/mod.ts",
    "./endian": "./src/endian/mod.ts",
    "./elias-fano-sequence": "./src/elias-fano-sequence/mod.ts",
    "./f32-vector": "./src/f32-vector/mod.ts",
    "./flat-hash": "./src/flat-hash/mod.ts",
    "./i32-array": "./src/i32-array/mod.ts",
    "./json": "./src/json/mod.ts",
    "./matrix2d": "./src/matrix2d/mod.ts",
    "./matrix3d": "./src/matrix3d/mod.ts",
    "./rank-select-bitvector": "./src/rank-select-bitvector/mod.ts",
    "./roaring-uint32-set": "./src/roaring-uint32-set/mod.ts",
    "./static-mphf-u32": "./src/static-mphf-u32/mod.ts",
    "./packed-delta-uint32-list": "./src/packed-delta-uint32-list/mod.ts",
    "./wavelet-matrix-uint32": "./src/wavelet-matrix-uint32/mod.ts"
  },
  "sideEffects": false,
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "just build",
    "prepack": "just build",
    "check:vite": "vite build examples/vite",
    "test": "deno test -A",
    "bench": "deno bench -A",
    "bench:adaptive-simd-page-i32": "vitest bench experiments/adaptive-simd-page-i32",
    "bench:bitset": "vitest bench experiments/bitset",
    "bench:binary-vector-index": "vitest bench experiments/binary-vector-index",
    "bench:bit-sliced-column": "vitest bench experiments/bit-sliced-column",
    "bench:endian": "deno bench -A bench.ts --filter 'decode u32be'",
    "bench:elias-fano-sequence": "vitest bench experiments/elias-fano-sequence",
    "bench:f32-vector": "vitest bench experiments/f32-vector",
    "bench:flat-hash": "vitest bench experiments/flat-hash",
    "bench:i32-array": "vitest bench experiments/i32-array",
    "bench:json": "vitest bench experiments/json",
    "bench:matrix2d": "vitest bench experiments/matrix2d",
    "bench:matrix3d": "vitest bench experiments/matrix3d",
    "bench:rank-select-bitvector": "vitest bench experiments/rank-select-bitvector",
    "bench:roaring-uint32-set": "vitest bench experiments/roaring-uint32-set",
    "bench:static-mphf-u32": "vitest bench experiments/static-mphf-u32",
    "bench:packed-delta-uint32-list": "vitest bench experiments/packed-delta-uint32-list",
    "bench:wavelet-matrix-uint32": "vitest bench experiments/wavelet-matrix-uint32",
    "bench:record:bitset": "vitest bench experiments/bitset --outputJson experiments/bitset/benchmarks/baseline.json",
    "bench:record:binary-vector-index": "vitest bench experiments/binary-vector-index --outputJson experiments/binary-vector-index/benchmarks/baseline.json",
    "bench:record:adaptive-simd-page-i32": "vitest bench experiments/adaptive-simd-page-i32 --outputJson experiments/adaptive-simd-page-i32/benchmarks/baseline.json",
    "bench:record:bit-sliced-column": "vitest bench experiments/bit-sliced-column --outputJson experiments/bit-sliced-column/benchmarks/baseline.json",
    "bench:record:elias-fano-sequence": "vitest bench experiments/elias-fano-sequence --outputJson experiments/elias-fano-sequence/benchmarks/baseline.json",
    "bench:record:f32-vector": "vitest bench experiments/f32-vector --outputJson experiments/f32-vector/benchmarks/baseline.json",
    "bench:record:flat-hash": "vitest bench experiments/flat-hash --outputJson experiments/flat-hash/benchmarks/baseline.json",
    "bench:record:i32-array": "vitest bench experiments/i32-array --outputJson experiments/i32-array/benchmarks/baseline.json",
    "bench:record:json": "vitest bench experiments/json --outputJson experiments/json/benchmarks/baseline.json",
    "bench:record:matrix2d": "vitest bench experiments/matrix2d --outputJson experiments/matrix2d/benchmarks/baseline.json",
    "bench:record:matrix3d": "vitest bench experiments/matrix3d --outputJson experiments/matrix3d/benchmarks/baseline.json",
    "bench:record:rank-select-bitvector": "vitest bench experiments/rank-select-bitvector --outputJson experiments/rank-select-bitvector/benchmarks/baseline.json",
    "bench:record:roaring-uint32-set": "vitest bench experiments/roaring-uint32-set --outputJson experiments/roaring-uint32-set/benchmarks/baseline.json",
    "bench:record:static-mphf-u32": "vitest bench experiments/static-mphf-u32 --outputJson experiments/static-mphf-u32/benchmarks/baseline.json",
    "bench:record:packed-delta-uint32-list": "vitest bench experiments/packed-delta-uint32-list --outputJson experiments/packed-delta-uint32-list/benchmarks/baseline.json",
    "bench:record:wavelet-matrix-uint32": "vitest bench experiments/wavelet-matrix-uint32 --outputJson experiments/wavelet-matrix-uint32/benchmarks/baseline.json",
    "bench:compare:bitset": "vitest bench experiments/bitset --compare experiments/bitset/benchmarks/baseline.json",
    "bench:compare:binary-vector-index": "vitest bench experiments/binary-vector-index --compare experiments/binary-vector-index/benchmarks/baseline.json",
    "bench:compare:adaptive-simd-page-i32": "vitest bench experiments/adaptive-simd-page-i32 --compare experiments/adaptive-simd-page-i32/benchmarks/baseline.json",
    "bench:compare:bit-sliced-column": "vitest bench experiments/bit-sliced-column --compare experiments/bit-sliced-column/benchmarks/baseline.json",
    "bench:compare:elias-fano-sequence": "vitest bench experiments/elias-fano-sequence --compare experiments/elias-fano-sequence/benchmarks/baseline.json",
    "bench:compare:f32-vector": "vitest bench experiments/f32-vector --compare experiments/f32-vector/benchmarks/baseline.json",
    "bench:compare:flat-hash": "vitest bench experiments/flat-hash --compare experiments/flat-hash/benchmarks/baseline.json",
    "bench:compare:i32-array": "vitest bench experiments/i32-array --compare experiments/i32-array/benchmarks/baseline.json",
    "bench:compare:json": "vitest bench experiments/json --compare experiments/json/benchmarks/baseline.json",
    "bench:compare:matrix2d": "vitest bench experiments/matrix2d --compare experiments/matrix2d/benchmarks/baseline.json",
    "bench:compare:matrix3d": "vitest bench experiments/matrix3d --compare experiments/matrix3d/benchmarks/baseline.json",
    "bench:compare:rank-select-bitvector": "vitest bench experiments/rank-select-bitvector --compare experiments/rank-select-bitvector/benchmarks/baseline.json",
    "bench:compare:roaring-uint32-set": "vitest bench experiments/roaring-uint32-set --compare experiments/roaring-uint32-set/benchmarks/baseline.json",
    "bench:compare:static-mphf-u32": "vitest bench experiments/static-mphf-u32 --compare experiments/static-mphf-u32/benchmarks/baseline.json",
    "bench:compare:packed-delta-uint32-list": "vitest bench experiments/packed-delta-uint32-list --compare experiments/packed-delta-uint32-list/benchmarks/baseline.json",
    "bench:compare:wavelet-matrix-uint32": "vitest bench experiments/wavelet-matrix-uint32 --compare experiments/wavelet-matrix-uint32/benchmarks/baseline.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/jsimd.git"
  },
  "homepage": "https://github.com/mizchi/jsimd#readme",
  "bugs": "https://github.com/mizchi/jsimd/issues",
  "keywords": [
    "simd",
    "typescript",
    "wasm",
    "webassembly"
  ],
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "4.1.11"
  }
}
