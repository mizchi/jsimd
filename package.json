{
  "name": "@mizchi/jsimd",
  "version": "0.1.3",
  "description": "Prebuilt WebAssembly SIMD kernels and Wasm-resident data structures for JavaScript",
  "type": "module",
  "exports": {
    ".": "./dist/bytes/mod.js",
    "./adaptive-simd-page-i32": "./dist/adaptive-simd-page-i32/mod.js",
    "./bitset": "./dist/bitset/mod.js",
    "./bitmap": "./dist/bitset/mod.js",
    "./bit-vector": "./dist/rank-select-bitvector/mod.js",
    "./bit-matrix": "./dist/bit-matrix/mod.js",
    "./byte-key-flat-hash": "./dist/byte-key-flat-hash/mod.js",
    "./binary-vector-index": "./dist/binary-vector-index/mod.js",
    "./bit-sliced-column": "./dist/bit-sliced-column/mod.js",
    "./endian": "./dist/endian/mod.js",
    "./elias-fano-sequence": "./dist/elias-fano-sequence/mod.js",
    "./f32-vector": "./dist/f32-vector/mod.js",
    "./flat-hash": "./dist/flat-hash/mod.js",
    "./flat-hash-fixed16": "./dist/flat-hash-fixed16/mod.js",
    "./fingerprint-group16": "./dist/fingerprint-group16/mod.js",
    "./i32-array": "./dist/i32-array/mod.js",
    "./json": "./dist/json/mod.js",
    "./matrix2d": "./dist/matrix2d/mod.js",
    "./matrix3d": "./dist/matrix3d/mod.js",
    "./rank-select-bitvector": "./dist/rank-select-bitvector/mod.js",
    "./rank-select-bitmap": "./dist/rank-select-bitvector/mod.js",
    "./roaring-uint32-set": "./dist/roaring-uint32-set/mod.js",
    "./roaring-bitmap": "./dist/roaring-uint32-set/mod.js",
    "./static-mphf-u32": "./dist/static-mphf-u32/mod.js",
    "./packed-delta-uint32-list": "./dist/packed-delta-uint32-list/mod.js",
    "./wavelet-matrix-uint32": "./dist/wavelet-matrix-uint32/mod.js"
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "just build-package",
    "prepack": "just build-package",
    "check:vite": "vite build examples/vite",
    "test": "deno test -A",
    "bench": "deno bench -A",
    "bench:adaptive-simd-page-i32": "vitest bench experiments/adaptive-simd-page-i32",
    "bench:bitset": "vitest bench experiments/bitset",
    "bench:bit-matrix": "vitest bench experiments/bit-matrix",
    "bench:byte-key-flat-hash": "vitest bench experiments/byte-key-flat-hash",
    "bench:binary-vector-index": "vitest bench experiments/binary-vector-index",
    "bench:bit-sliced-column": "vitest bench experiments/bit-sliced-column",
    "bench:endian": "deno bench -A bench.ts --filter 'decode u32be'",
    "bench:elias-fano-sequence": "vitest bench experiments/elias-fano-sequence",
    "bench:f32-vector": "vitest bench experiments/f32-vector",
    "bench:flat-hash": "vitest bench experiments/flat-hash",
    "bench:flat-hash-fixed16": "vitest bench experiments/flat-hash-fixed16",
    "bench:fingerprint-group16": "vitest bench experiments/fingerprint-group16",
