    "bench:record:bit-matrix": "vitest bench experiments/bit-matrix --outputJson experiments/bit-matrix/benchmarks/baseline.json",
    "bench:record:byte-key-flat-hash": "vitest bench experiments/byte-key-flat-hash --outputJson experiments/byte-key-flat-hash/benchmarks/baseline.json",
    "bench:record:binary-vector-index": "vitest bench experiments/binary-vector-index --outputJson experiments/binary-vector-index/benchmarks/baseline.json",
